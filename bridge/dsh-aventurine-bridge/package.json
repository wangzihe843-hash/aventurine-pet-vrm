{
  "name": "dsh-aventurine-bridge",
  "version": "0.2.0",
  "description": "Writes DSH agent status and durable task events to ~/.dsh/aventurine-pet for the Aventurine desktop pet.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/constants.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
